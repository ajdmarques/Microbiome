for (h in seq_along(habitats)){
genome_names = c("genome",
colnames(genome_counts)[colnames(genome_counts) %in%                                         rownames(sample_metadata_row[sample_metadata_row$habitat==habitats[h],])])
genome_counts_H <-  genome_counts[,genome_names]
genome_counts_FH <- genome_counts_H[genome_counts_H$genome %in% rownames(genome_gifts),]
genome_counts_FH <- genome_counts_FH %>%
remove_rownames() %>%
column_to_rownames(., "genome") %>%
filter(rowSums(. != 0, na.rm = TRUE) > 0) %>%
select_if(~!all(. == 0))%>%
rownames_to_column(., "genome")
genome_gifts_H <- genome_gifts[rownames(genome_gifts) %in% genome_counts_FH$genome,]
genome_gifts_H <- genome_gifts1[, colSums(genome_gifts_H != 0) > 0]
dist_H <- genome_gifts_H %>%
to.elements(., GIFT_db) %>%
traits2dist(., method = "gower")
# make new beta diversity matrix
beta_q1f_H[[h]] <- genome_counts_FH %>%
column_to_rownames(., "genome") %>%
filter(rowSums(. != 0, na.rm = TRUE) > 0) %>%
select_if(~!all(. == 0)) %>%
hillpair(., q = 1, dist = dist_H, metric = "S")
attr(beta_q1f_H[[h]],"Labels") <- genome_names[-1]
bdH =  betadisper(beta_q1f_H[[h]], sample_metadata_row[sample_metadata_row$habitat==habitats[h],]$event_id) %>% permutest(., pairwise = TRUE)
adH =  adonis2(beta_q1f_H[[h]] ~ event_id + (1 | pc1),
data = sample_metadata[sample_metadata$habitat==habitats[h],] %>% arrange(match(sample,labels(beta_q1f_H[[h]]))),
permutations = 9999)
bdHp_q1f[[h]] =
beta_q1f_H[[h]] %>%
