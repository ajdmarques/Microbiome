c(beta_Hq0n$R2[1], beta_Hq1p$R2[1], beta_Hq1n$R2[1], beta_Hq1f$R2[1]),
c(beta_Hq0n$`Pr(>F)`[1], beta_Hq1p$`Pr(>F)`[1], beta_Hq1n$`Pr(>F)`[1], beta_Hq1f$`Pr(>F)`[1]),
c(beta_IDq0n$R2[1], beta_IDq1p$R2[1], beta_IDq1n$R2[1], beta_IDq1f$R2[1]),
c(beta_IDq0n$`Pr(>F)`[1], beta_IDq1p$`Pr(>F)`[1], beta_IDq1n$`Pr(>F)`[1], beta_IDq1f$`Pr(>F)`[1])
) %>% `colnames<-`(c("Metric", "Habitat R2", "Habitat P", "Site R2", "Site P")),
file = "data/anova_table.Rds")
tmp_df =
rbind.data.frame(
c("richness",
beta_IDq0n_disp$statistic[2],beta_IDq0n_disp$tab$`Pr(>F)`[1],
beta_IDq0n$F[1],beta_IDq0n$`Pr(>F)`[1]),
c("neut.div.",
beta_IDq1n_disp$statistic[2],beta_IDq1n_disp$tab$`Pr(>F)`[1],
beta_IDq1n$F[1],beta_IDq1n$`Pr(>F)`[1]),
c("phylo.div.",
beta_IDq1p_disp$statistic[2],beta_IDq1p_disp$tab$`Pr(>F)`[1],
beta_IDq1p$F[1],beta_IDq1p$`Pr(>F)`[1]),
c("funct.div.",
beta_IDq1f_disp$statistic[2],beta_IDq1f_disp$tab$`Pr(>F)`[1],
beta_IDq1f$F[1],beta_IDq1f$`Pr(>F)`[1])
) %>%
`colnames<-`(c("measure",
"B",
"B_p",
"F",
"F_p")) %>%
mutate(B_p = p.adjust(B_p,"fdr"),
F_p = p.adjust(F_p,"fdr")) %>%
mutate(B = as.numeric(B),
F = as.numeric(F)) %>%
mutate(across(where(is.numeric), round, 2))
tmp_df
write.table(tmp_df,
"data/supplements/PERMANOVA_site.csv",
sep = ","
)
#Render composite figure
ggarrange(bdHp_q0n[[1]],bdHp_q1n[[1]],bdHp_q1p[[1]],bdHp_q1f[[1]],
bdHp_q0n[[2]],bdHp_q1n[[2]],bdHp_q1p[[2]],bdHp_q1f[[2]],
ncol=4, nrow=2,
labels = c("A", "B", "C", "D", "E", "F", "G", "H"),
common.legend = TRUE,
legend="right") ->
g
g
ggsave(paste0('figure/site_beta_diversity.png'), g, width=26, height=15, units='cm')
