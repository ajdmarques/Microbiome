group_by(genome) %>%
summarise(mean=sum(relabun)) %>%
arrange(-mean) %>%
select(genome) %>%
filter(genome %in% ancombc_rand_table_mag$taxon) %>%
pull()
for(q in seq_along(query_variables)[-c(1,3)]){
print(
mag_summary %>%
left_join(genome_metadata %>% select(genome,phylum) %>% unique(),by=join_by(genome==genome)) %>%
filter(sample %in% sample_metadata$sample) %>%
filter(genome %in% mag_arrange) %>%
mutate(genome=factor(genome,levels=rev(mag_arrange))) %>%
filter(relabun > 0) %>%
ggplot(aes(x=relabun, y=genome, group=genome, color=phylum)) +
scale_color_manual(values=phylum_colors[-8]) +
geom_jitter(alpha=0.5) +
theme_minimal() +
facet_nested(as.formula(paste("~", query_variables[q])),scales = "free") +
labs(y="MAG", x="Relative abundance", color="Phylum")
)}
res_prim = ancom_rand_output_mag_habitat$res
df_habitaturban = res_prim %>%
dplyr::select(taxon, ends_with("habitaturban"))
df_fig_habitaturban = df_habitaturban %>%
dplyr::filter(diff_habitaturban == 1) %>%
dplyr::arrange(desc(lfc_habitaturban)) %>%
dplyr::mutate(direct = ifelse(lfc_habitaturban > 0, "Positive LFC", "Negative LFC"),
color = ifelse(diff_robust_habitaturban, "aquamarine3", "black"))
df_fig_habitaturban$taxon = factor(df_fig_habitaturban$taxon, levels = df_fig_habitaturban$taxon)
df_fig_habitaturban$direct = factor(df_fig_habitaturban$direct,
levels = c("Positive LFC", "Negative LFC"))
fig_habitaturban = df_fig_habitaturban %>%
ggplot(aes(x = taxon, y = lfc_habitaturban, fill = direct)) +
geom_bar(stat = "identity", width = 0.7, color = "black",
position = position_dodge(width = 0.4)) +
geom_errorbar(aes(ymin = lfc_habitaturban - se_habitaturban, ymax =
lfc_habitaturban + se_habitaturban),
width = 0.2, position = position_dodge(0.05), color = "black") +
labs(x = NULL, y = "Log fold change",
title = "Log fold changes between habitat") +
scale_fill_discrete(name = NULL) +
scale_color_discrete(name = NULL) +
theme_bw() +
theme(plot.title = element_text(hjust = 0.5),
panel.grid.minor.y = element_blank(),
axis.text.x = element_text(angle = 60, hjust = 1,
color = df_fig_habitaturban$color))
fig_habitaturban
