beta_Hq0n$F[1],beta_Hq0n$`Pr(>F)`[1]),
c("neut.div.",
beta_q1n_disp$statistic[2],beta_q1n_disp$tab$`Pr(>F)`[1],
beta_Hq1n$F[1],beta_Hq1n$`Pr(>F)`[1]),
c("phylo.div.",
beta_q1p_disp$statistic[2],beta_q1p_disp$tab$`Pr(>F)`[1],
beta_Hq1p$F[1],beta_Hq1p$`Pr(>F)`[1]),
c("funct.div.",
beta_q1f_disp$statistic[2],beta_q1f_disp$tab$`Pr(>F)`[1],
beta_Hq1f$F[1],beta_Hq1f$`Pr(>F)`[1])
) %>%
`colnames<-`(c("measure",
"B",
"B_p",
"F",
"F_p")) %>%
mutate(B_p = p.adjust(B_p,"fdr"),
F_p = p.adjust(F_p,"fdr"))%>%
mutate(B = as.numeric(B),
F = as.numeric(F)) %>%
mutate(across(where(is.numeric), round, 2))
tmp_df
