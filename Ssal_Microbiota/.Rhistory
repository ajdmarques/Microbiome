ggplot(aes(x=relabun.neg, y=class, group=class, color=phylum)) +
scale_color_manual(values=phylum_colors[-8]) +
geom_bar() +
geom_jitter(alpha=0.5) +
theme_minimal() +
theme(legend.position="none") +
#facet_nested(as.formula(paste("~", query_variables[q])),scales = "free") +
labs(y="Class", x="Relative abundance", color="Phylum") +
scale_y_discrete(labels=str_remove(class_arrange,"c__"))
