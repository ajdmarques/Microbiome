genome_GIFT_mean = list()
# identify mean element probability for either class
genome_GIFT_mean[["c__Gammaproteobacteria"]] =
colMeans(
GIFTs_elements[
rownames(GIFTs_elements) %in%
genome_metadata[genome_metadata$class %in% c("c__Gammaproteobacteria"),]$genome,
] %>%
as.data.frame() )
genome_GIFT_mean[["c__Bacteroidia"]] =
colMeans(
GIFTs_elements[
rownames(GIFTs_elements) %in%
genome_metadata[genome_metadata$class %in% c("c__Bacteroidia"),]$genome,
] %>%
as.data.frame() )
df_tmp =
data.frame(gift = colnames(GIFTs_elements),
c__Gammaproteobacteria = genome_GIFT_mean[["c__Gammaproteobacteria"]],
c__Bacteroidia = genome_GIFT_mean[["c__Bacteroidia"]]) %>%
mutate(delta = abs(c__Gammaproteobacteria - c__Bacteroidia)) %>%
filter(delta > (mean(delta) + (sd(delta *2))))
element_labels =
GIFT_db2[GIFT_db2$Code_element %in% df_tmp$gift,] %>%
select(Element) %>%
unique()
# filter to elements where the DELTA deviates by > 2 STDEV
data.frame(gift = colnames(GIFTs_elements),
c__Gammaproteobacteria = genome_GIFT_mean[["c__Gammaproteobacteria"]],
c__Bacteroidia = genome_GIFT_mean[["c__Bacteroidia"]]) %>%
mutate(delta = abs(c__Gammaproteobacteria - c__Bacteroidia)) %>%
filter(delta > (mean(delta) + (sd(delta *2)))) %>%
ggplot() +
geom_point(aes(x=gift, y=c__Gammaproteobacteria), shape = 15, colour="#E0A608", size=3) +
geom_point(aes(x=gift, y=c__Bacteroidia),  shape = 17, colour="#823838", size=3) +
scale_x_discrete(labels = element_labels$Element) +
theme_minimal()+
ylab("GIFT Probability") +
ylim(0,1) +
xlab("GIFT Element") +
theme(axis.title.x = element_blank(),
