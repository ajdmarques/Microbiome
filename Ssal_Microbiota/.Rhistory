# relative urban abundance
rel.abund.urban =
phylum_summary %>%
group_by(phylum) %>%
filter(habitat=="urban") %>%
summarise(mean=mean(relabun)) %>%
arrange(-mean)
# relative rural abundance
rel.abund.rural =
phylum_summary %>%
group_by(phylum) %>%
filter(habitat=="rural") %>%
summarise(mean=mean(relabun)) %>%
arrange(-mean)
# relative toal abundance
rel.abund.total =
phylum_summary %>%
group_by(phylum) %>%
summarise(mean=mean(relabun)) %>%
arrange(-mean)
rel.abun.df = merge(rel.abund.urban,rel.abund.rural, by="phylum")
colnames(rel.abun.df) = c("phylum","urban","rural")
rel.abun.df = merge(rel.abun.df,rel.abund.total, by="phylum")
colnames(rel.abun.df) = c("phylum","urban","rural","overall")
saveRDS(rel.abun.df,"figure/table_relative_abundance.RDS")
phylum_tukey =
TukeyHSD(
aov(relabun ~ phylum * habitat,
data =
phylum_summary %>%
left_join(genome_metadata %>% select(phylum,phylum) %>% unique(),by=join_by(phylum==phylum)) %>%
filter(phylum %in% phylum_arrange[1:20]) %>%
mutate(phylum=factor(phylum,levels=rev(phylum_arrange[1:20]))) %>%
filter(sample %in% sample_metadata$sample) %>%
filter(relabun > 0)
)
)
phylum_tukey = as.data.frame(phylum_tukey[[3]])
phylum_tukey$j = sub("-.*", "", rownames(phylum_tukey))
phylum_tukey$k = sub(".*-", "", rownames(phylum_tukey))
phylum_tukey$j = gsub(paste(c(":rural",":urban"), collapse = '|'), '', phylum_tukey$j)
phylum_tukey$k = gsub(paste(c(":rural",":urban"), collapse = '|'), '', phylum_tukey$k)
phylum_tukey[
phylum_tukey$j == phylum_tukey$k
, !colnames(phylum_tukey) %in% c("j","k")]
phylum_tukey[
phylum_tukey$j == phylum_tukey$k & # when comparing specific taxa between habitat
phylum_tukey$`p adj` < 0.05 # sig
, !colnames(phylum_tukey) %in% c("j","k")]
phylum_tukey =
TukeyHSD(
aov(relabun ~ phylum * swab,
