### Confounding variables

In order to determine the impact that potentially confounding variables (e.g. sample date, extraction date, etc.) may have on the observed differences between habitats, I will examine the correlation between variables. Begin first by converting the merged data file into a series of occurrence matrices.

```{r Occurrence Matrices,  warning=FALSE, message=FALSE}
# Lists to save outputs
pres.data <- list()
rra.data <- list()
Y.data <- list()
dist.Y <- list()

# List prey names
levels(as.factor(merged.table.coalesce$prey.id)) -> prey.name


for (j in seq_along(group.levels)){
## Convert prey reads to presence/absence
pres.data[[j]] <- merged.table.coalesce %>%
  # Apply filters
  filter(diet.status == "ok") %>%
  select(prey.id, sample, 
         group.names[j],
         blankfiltered.reads) %>%
  group_by(prey.id, sample) %>%
  mutate_if(is.double, ~1 * (. > 0)) %>%
  pivot_wider(names_from = prey.id, values_from = blankfiltered.reads, values_fn = mean) %>%
  mutate_if(is.numeric, replace_na, 0) %>%
  mutate_if(is.numeric, ~1 * (. > 0)) %>% # convert to presence absence (added 29.06.23) 
  as.data.frame()

##Number of reads per prey
rra.data[[j]] <- merged.table.coalesce %>%
  # Apply filters
  filter(diet.status == "ok") %>%
  select(prey.id, sample, 
         group.names[j],
         blankfiltered.reads) %>%
  group_by(prey.id, sample) %>%
  pivot_wider(names_from = prey.id, values_from = blankfiltered.reads, values_fn = sum) %>%
  mutate_if(is.numeric, replace_na, 0) %>%
  as.data.frame()

## Proportion of species reads
rra.data[[j]] <- data.frame(rra.data[[j]][!colnames(rra.data[[j]]) %in% prey.name],
                            rra.data[[j]][colnames(rra.data[[j]]) %in% prey.name]/
                              rowSums(rra.data[[j]][colnames(rra.data[[j]]) %in% prey.name]))

# Create distance matrix
Y.data[[j]] <- pres.data[[j]][,colnames(pres.data[[j]]) %in% prey.name] #select only columns with prey
# Abundance (RRA or weighted occurrences)
dist.Y[[j]] <- vegdist(Y.data[[j]], method="jaccard")
}
