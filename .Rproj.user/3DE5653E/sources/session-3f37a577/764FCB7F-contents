      data=phylum.richness.in[[i]][,
                                   c(colnames(phylum.richness.in[[i]])[1:6],
                                     phylum.prey.name[[i]],
                                     "Richness")], 
    family=poisson) -> 
    phylum.rich.glm[[i]]
}
```


