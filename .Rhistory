"9703_1","9703_2","9703_3", # GVA9703 replicates 1-3
"EN_1","EN_2","EN_3", # extraction negative replicates 1-3
"RN_1","RN_2","RN_3"  # reaction replicates 1-3
)
# list files
list.files(dir_raw,
pattern = ".fastq.gz",
